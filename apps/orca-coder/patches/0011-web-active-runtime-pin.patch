diff --git a/src/renderer/src/web/web-preload-api.ts b/src/renderer/src/web/web-preload-api.ts
index 8c44b5cff..85d4226e4 100644
--- a/src/renderer/src/web/web-preload-api.ts
+++ b/src/renderer/src/web/web-preload-api.ts
@@ -3556,7 +3606,23 @@ function getStoredSettings(): GlobalSettings {
       ...defaults,
       floatingTerminalEnabled: false,
       rightSidebarOpenByDefault: false,
-      activeRuntimeEnvironmentId: null
+      // Why: a desktop app dials runtimes it chose, so "which one is active" is a real
+      // preference. A browser served BY a runtime has no such choice — the web client
+      // stores exactly ONE environment (readStoredWebRuntimeEnvironment is singular, and
+      // resolveEnvironment refuses any other selector), so leaving this null only meant
+      // "the paired server, spelled nowhere". Every web-client ownership decision reads
+      // this field — the floating workspace owner, the local-PTY backstop, and both
+      // environment lookups in web-runtime-session — so an unset value silently routed
+      // them at a local machine the browser does not have: `pty.spawn` rejects with
+      // "Local PTYs are unavailable in the web client", which is what the Settings skill
+      // terminal showed until the user found Advanced > Active Server and picked the one
+      // server on the list. Default it to the paired environment instead.
+      //
+      // Still a default, not an override: writeStoredSettings only persists this key when
+      // setActiveRuntimeEnvironmentPreference passes it explicitly, so an absent key means
+      // "never chosen" and mergeSettings lets a real choice — including an explicit null —
+      // win over this base.
+      activeRuntimeEnvironmentId: readStoredWebRuntimeEnvironment()?.id ?? null
     },
     migratedStored
   )
