+import { describe, expect, it, vi } from 'vitest'
+import type { AgentStatusIpcPayload } from '../../../../shared/agent-status-types'
+import type { RpcContext } from '../core'
+import { AGENT_STATUS_METHODS } from './agent-status'
+
+// The identity native chat resolves a transcript from; without it the view renders its empty state.
+const HOOK_ROW = {
+  paneKey: 'tab-1:leaf-1',
+  state: 'done',
+  prompt: 'audit the patches',
+  agentType: 'claude',
+  connectionId: null,
+  receivedAt: 10,
+  stateStartedAt: 10,
+  providerSession: { id: 'sess-1', transcriptPath: '/home/coder/.claude/sess-1.jsonl' }
+} as unknown as AgentStatusIpcPayload
+
+function handlerFor(name: string): (...args: never[]) => Promise<unknown> {
+  const method = AGENT_STATUS_METHODS.find((candidate) => candidate.name === name)
+  if (!method) {
+    throw new Error(`${name} not registered`)
+  }
+  return method.handler as (...args: never[]) => Promise<unknown>
+}
+
+describe('agentStatus RPC', () => {
+  it('hands a paired client the hook rows carrying transcript identity', async () => {
+    const handler = handlerFor('agentStatus.getSnapshot') as (
+      params: unknown,
+      ctx: RpcContext
+    ) => Promise<{ entries: AgentStatusIpcPayload[] }>
+
+    const result = await handler(null, {
+      runtime: { getAgentStatusIpcRows: () => [HOOK_ROW] } as unknown as RpcContext['runtime']
+    })
+
+    expect(result.entries).toHaveLength(1)
+    expect(result.entries[0]!.providerSession).toEqual({
+      id: 'sess-1',
+      transcriptPath: '/home/coder/.claude/sess-1.jsonl'
+    })
+  })
+
+  it('republishes the whole snapshot on each hook change, so a clear is an absent paneKey', async () => {
+    const handler = handlerFor('agentStatus.subscribe') as (
+      params: unknown,
+      ctx: RpcContext,
+      emit: (value: unknown) => void
+    ) => Promise<void>
+
+    const rows: AgentStatusIpcPayload[] = [HOOK_ROW]
+    let notify = (): void => {}
+    const emitted: { type?: string; entries?: AgentStatusIpcPayload[] }[] = []
+
+    await handler(
+      {},
+      {
+        runtime: {
+          getAgentStatusIpcRows: () => [...rows],
+          subscribeAgentStatusRows: (listener: () => void) => {
+            notify = listener
+            return () => {}
+          },
+          registerSubscriptionCleanup: vi.fn(),
+          cleanupSubscription: vi.fn(),
+          cleanupSubscriptionsByPrefix: vi.fn()
+        } as unknown as RpcContext['runtime'],
+        connectionId: 'connection-1'
+      },
+      (value) => emitted.push(value as { type?: string; entries?: AgentStatusIpcPayload[] })
+    )
+
+    expect(emitted).toHaveLength(1)
+    expect(emitted[0]!.entries).toHaveLength(1)
+
+    rows.length = 0
+    notify()
+
+    expect(emitted).toHaveLength(2)
+    expect(emitted[1]!.entries).toEqual([])
+  })
+})
diff --git a/src/main/runtime/rpc/methods/agent-status.ts b/src/main/runtime/rpc/methods/agent-status.ts
new file mode 100644
index 000000000..6d4bf4ba6
--- /dev/null
+++ b/src/main/runtime/rpc/methods/agent-status.ts
@@ -0,0 +1,66 @@
+import { z } from 'zod'
+import { defineMethod, defineStreamingMethod, type RpcAnyMethod } from '../core'
+
+// Why: the desktop renderer gets hook rows over `agentStatus:*` IPC, which needs a BrowserWindow
+// `orca serve` never opens — so the web preload stubbed the namespace and native chat could not
+// resolve providerSession. Mirrors those handlers 1:1 so the web client feeds the renderer's
+// existing setAgentStatus path. Runtime-scope only: rows carry prompts, tool input and transcript
+// paths, and phones already receive agent status through the mobile session tabs snapshot.
+
+const AgentStatusSubscription = z
+  .object({ subscriptionId: z.string().min(1).max(200).optional() })
+  .strict()
+
+function subscriptionKey(connectionId: string | undefined, subscriptionId?: string): string {
+  return `agentStatus:${connectionId ?? 'local'}:${subscriptionId ?? 'default'}`
+}
+
+export const AGENT_STATUS_METHODS: readonly RpcAnyMethod[] = [
+  defineMethod({
+    name: 'agentStatus.getSnapshot',
+    params: null,
+    handler: async (_params, { runtime }) => ({ entries: runtime.getAgentStatusIpcRows() })
+  }),
+  defineStreamingMethod({
+    name: 'agentStatus.subscribe',
+    params: AgentStatusSubscription,
+    handler: async (params, { runtime, connectionId }, emit) => {
+      let closed = false
+      let unsubscribe = (): void => {}
+      runtime.registerSubscriptionCleanup(
+        subscriptionKey(connectionId, params.subscriptionId),
+        () => {
+          closed = true
+          unsubscribe()
+          emit({ type: 'end' })
+        },
+        connectionId
+      )
+      if (closed) {
+        return
+      }
+      emit({ type: 'snapshot', entries: runtime.getAgentStatusIpcRows() })
+      // Why: the hook server's change signal carries no payload, so republish the whole snapshot
+      // and let the client diff — that also makes a clear observable as an absent paneKey, without
+      // taking over main's single-listener clear channel.
+      unsubscribe = runtime.subscribeAgentStatusRows(() => {
+        if (closed) {
+          return
+        }
+        emit({ type: 'snapshot', entries: runtime.getAgentStatusIpcRows() })
+      })
+    }
+  }),
+  defineMethod({
+    name: 'agentStatus.unsubscribe',
+    params: AgentStatusSubscription,
+    handler: async (params, { runtime, connectionId }) => {
+      if (params.subscriptionId) {
+        runtime.cleanupSubscription(subscriptionKey(connectionId, params.subscriptionId))
+        return { unsubscribed: true }
+      }
+      runtime.cleanupSubscriptionsByPrefix(`agentStatus:${connectionId ?? 'local'}:`)
+      return { unsubscribed: true }
+    }
+  })
+]
