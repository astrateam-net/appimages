+// Why: desktop feeds the renderer's agent-status store from `agentStatus:*` IPC, which needs a
+// BrowserWindow that `orca serve` never opens — so the store stayed empty and native chat could
+// not resolve providerSession. Route the same members at the runtime's agentStatus.* methods to
+// feed the identical setAgentStatus path. The server republishes a whole snapshot per hook change
+// (its change signal carries no payload), so set/clear are derived here by diffing and the desktop
+// callback contract reaches the renderer unchanged.
+function createWebAgentStatusApi(): Pick<
+  PreloadApi['agentStatus'],
+  'onSet' | 'onClear' | 'getSnapshot'
+> {
+  const setListeners = new Set<(payload: AgentStatusIpcPayload) => void>()
+  const clearListeners = new Set<(payload: AgentStatusClearIpcPayload) => void>()
+  let lastByPaneKey = new Map<string, string>()
+  let handle: { unsubscribe: () => void } | null = null
+  let cancelled = false
+
+  const applySnapshot = (rows: AgentStatusIpcPayload[]): void => {
+    const entries = rows.map(toWebSurfaceAgentStatusRow)
+    const next = new Map<string, string>()
+    for (const entry of entries) {
+      const serialized = JSON.stringify(entry)
+      next.set(entry.paneKey, serialized)
+      if (lastByPaneKey.get(entry.paneKey) === serialized) {
+        continue
+      }
+      for (const listener of setListeners) {
+        listener(entry)
+      }
+    }
+    for (const paneKey of lastByPaneKey.keys()) {
+      if (next.has(paneKey)) {
+        continue
+      }
+      for (const listener of clearListeners) {
+        listener({ paneKey })
+      }
+    }
+    lastByPaneKey = next
+  }
+
+  const ensureSubscribed = (): void => {
+    if (handle || cancelled) {
+      return
+    }
+    const environment = requireActiveEnvironmentOrNull()
+    if (!environment) {
+      return
+    }
+    cancelled = false
+    void getClientForEnvironment(environment)
+      .subscribe(
+        'agentStatus.subscribe',
+        {},
+        {
+          onResponse: (response) => {
+            if (!response.ok) {
+              return
+            }
+            const result = response.result as { type?: string; entries?: AgentStatusIpcPayload[] }
+            if (result?.type === 'snapshot' && Array.isArray(result.entries)) {
+              applySnapshot(result.entries)
+            }
+          }
+        }
+      )
+      .then((h) => {
+        handle = h
+      })
+      .catch((err: unknown) => {
+        console.warn('[agent-status] subscribe failed:', err)
+      })
+  }
+
+  const releaseWhenIdle = (): void => {
+    if (setListeners.size > 0 || clearListeners.size > 0) {
+      return
+    }
+    handle?.unsubscribe()
+    handle = null
+    lastByPaneKey = new Map()
+  }
+
+  return {
+    getSnapshot: async () => {
+      const result = await callRuntimeResult<{ entries?: AgentStatusIpcPayload[] }>(
+        'agentStatus.getSnapshot'
+      ).catch(() => ({ entries: [] }))
+      return Array.isArray(result?.entries) ? result.entries.map(toWebSurfaceAgentStatusRow) : []
+    },
+    onSet: (callback) => {
+      setListeners.add(callback)
+      ensureSubscribed()
+      return () => {
+        setListeners.delete(callback)
+        releaseWhenIdle()
+      }
+    },
+    onClear: (callback) => {
+      clearListeners.add(callback)
+      ensureSubscribed()
+      return () => {
+        clearListeners.delete(callback)
+        releaseWhenIdle()
+      }
+    }
+  }
+}
+
 // Why: web has no IPC for native-chat transcripts, so route readSession/subscribe through runtime RPC (as mobile does).
 function createNativeChatApi(): NativeChatApi {
   return {
